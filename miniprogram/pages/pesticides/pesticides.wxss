/* 农药列表页面样式 */
.container {
  background: #f5f5f5;
  min-height: 100vh;
}

/* 搜索区域 */
.search-section {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.search-bar {
  margin-bottom: 30rpx;
}

.search-input-container {
  position: relative;
}

.search-input {
  width: 100%;
  background: #f8f9fa;
  border-radius: 50rpx;
  padding: 24rpx 80rpx 24rpx 30rpx;
  font-size: 28rpx;
  color: #333;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.search-input:focus {
  border-color: #4CAF50;
  background: #fff;
  box-shadow: 0 0 0 4rpx rgba(76, 175, 80, 0.1);
}

.search-icon {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 60rpx;
  height: 60rpx;
  background: #4CAF50;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
}

/* 筛选区域 */
.filter-section {
  margin-bottom: 30rpx;
}

.filter-item-wrapper {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.filter-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  white-space: nowrap;
}

/* 下拉框容器 */
.dropdown-container {
  position: relative;
  flex: 1;
  max-width: 300rpx;
}

.dropdown-trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  border: 1rpx solid #e9ecef;
  font-size: 28rpx;
  color: #333;
  transition: all 0.3s;
}

.dropdown-trigger:active {
  background: #e9ecef;
}

.dropdown-text {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dropdown-arrow {
  font-size: 24rpx;
  color: #666;
  transition: transform 0.3s;
  margin-left: 10rpx;
}

.dropdown-arrow.open {
  transform: rotate(180deg);
}

/* 下拉选项 */
.dropdown-options {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  border: 1rpx solid #e9ecef;
  z-index: 1000;
  max-height: 400rpx;
  overflow-y: auto;
  opacity: 0;
  transform: translateY(-10rpx);
  transition: all 0.3s;
  pointer-events: none;
}

.dropdown-options.show {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.dropdown-option {
  padding: 20rpx;
  font-size: 28rpx;
  color: #333;
  border-bottom: 1rpx solid #f0f0f0;
  transition: background-color 0.2s;
}

.dropdown-option:last-child {
  border-bottom: none;
}

.dropdown-option:hover {
  background: #f8f9fa;
}

.dropdown-option.active {
  background: #e8f5e8;
  color: #4CAF50;
  font-weight: 500;
}

/* 排序区域 */
.sort-section {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.sort-item {
  padding: 12rpx 24rpx;
  background: #f0f0f0;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #666;
  transition: all 0.3s;
}

.sort-item.active {
  background: #e8f5e8;
  color: #4CAF50;
  font-weight: 500;
}

/* 农药列表 */
.pesticides-list {
  padding: 0 30rpx;
}

.pesticide-card {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s;
}

.pesticide-card:active {
  transform: translateY(-2rpx);
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.12);
}

.pesticide-image-container {
  position: relative;
  height: 300rpx;
  overflow: hidden;
}

.pesticide-image {
  width: 100%;
  height: 100%;
  background: #f0f0f0;
}

.category-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: #fff;
}

.badge-warning {
  background: rgba(255, 193, 7, 0.9);
}

.badge-danger {
  background: rgba(220, 53, 69, 0.9);
}

.badge-success {
  background: rgba(40, 167, 69, 0.9);
}

.badge-info {
  background: rgba(23, 162, 184, 0.9);
}

.pesticide-content {
  padding: 30rpx;
}

.pesticide-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.pesticide-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
  margin-right: 20rpx;
  line-height: 1.3;
}

.pesticide-stats {
  flex-shrink: 0;
}

.view-count {
  font-size: 22rpx;
  color: #999;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

/* 农药成分信息 */
.pesticide-ingredient {
  margin-bottom: 16rpx;
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
}

.ingredient-label {
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
  flex-shrink: 0;
}

.ingredient-text {
  font-size: 24rpx;
  color: #333;
  line-height: 1.5;
  flex: 1;
}

/* 农药描述 */
.pesticide-description {
  margin-bottom: 20rpx;
}

.description-text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 农药底部 */
.pesticide-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.create-time {
  font-size: 22rpx;
  color: #999;
}

.action-hint {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.hint-text {
  font-size: 22rpx;
  color: #4CAF50;
  font-weight: 500;
}

.arrow {
  font-size: 20rpx;
  color: #4CAF50;
  font-weight: bold;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #f3f3f3;
  border-top: 6rpx solid #4CAF50;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

.loading-spinner.small {
  width: 40rpx;
  height: 40rpx;
  border-width: 4rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #666;
}

/* 空状态 */
.empty-container {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 16rpx;
  display: block;
}

.empty-tip {
  font-size: 24rpx;
  color: #ccc;
  display: block;
}

/* 加载更多 */
.load-more {
  padding: 40rpx;
  text-align: center;
}

.load-more-btn {
  background: #f0f0f0;
  color: #666;
  border: none;
  border-radius: 50rpx;
  padding: 24rpx 48rpx;
  font-size: 26rpx;
  transition: all 0.3s;
}

.load-more-btn:active {
  background: #e0e0e0;
}

.load-more-text {
  font-size: 26rpx;
}

/* 底部加载状态 */
.bottom-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 40rpx;
}

/* 没有更多数据 */
.no-more {
  text-align: center;
  padding: 40rpx;
}

.no-more-text {
  font-size: 24rpx;
  color: #ccc;
}

