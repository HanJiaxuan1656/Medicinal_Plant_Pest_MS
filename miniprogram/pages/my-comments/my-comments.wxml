<!-- 我的评论页面 -->
<view class="container">
  <!-- 页面头部 -->
  <view class="page-header">
    <text class="page-title">我的评论</text>
    <text class="page-subtitle">查看和管理您发表的所有评论</text>
  </view>

  <!-- 统计信息 -->
  <view class="stats-section">
    <view class="stat-card">
      <view class="stat-icon total">💬</view>
      <view class="stat-content">
        <text class="stat-number">{{stats.total || 0}}</text>
        <text class="stat-label">总评论数</text>
      </view>
    </view>
    <view class="stat-card">
      <view class="stat-icon pending">⏰</view>
      <view class="stat-content">
        <text class="stat-number">{{stats.pending || 0}}</text>
        <text class="stat-label">审核中</text>
      </view>
    </view>
    <view class="stat-card">
      <view class="stat-icon approved">✅</view>
      <view class="stat-content">
        <text class="stat-number">{{stats.approved || 0}}</text>
        <text class="stat-label">已通过</text>
      </view>
    </view>
  </view>

  <!-- 筛选器 -->
  <view class="filter-section">
    <view class="filter-row">
      <view class="filter-item">
        <text class="filter-label">评论类型：</text>
        <view class="dropdown-container">
          <view class="dropdown-trigger" bindtap="toggleTypeDropdown">
            <text class="dropdown-text">{{selectedTypeText}}</text>
            <text class="dropdown-arrow {{typeDropdownOpen ? 'open' : ''}}">▼</text>
          </view>
          <view class="dropdown-options {{typeDropdownOpen ? 'show' : ''}}" catchtap="stopPropagation">
            <view class="dropdown-option {{selectedType === '' ? 'active' : ''}}"
                  bindtap="onTypeSelect" data-value="" data-text="全部类型">
              全部类型
            </view>
            <view class="dropdown-option {{selectedType === 'plant' ? 'active' : ''}}"
                  bindtap="onTypeSelect" data-value="plant" data-text="植物">
              植物
            </view>
            <view class="dropdown-option {{selectedType === 'pest_disease' ? 'active' : ''}}"
                  bindtap="onTypeSelect" data-value="pest_disease" data-text="病虫害">
              病虫害
            </view>
            <view class="dropdown-option {{selectedType === 'pesticide' ? 'active' : ''}}"
                  bindtap="onTypeSelect" data-value="pesticide" data-text="农药">
              农药
            </view>
          </view>
        </view>
      </view>

      <view class="filter-item">
        <text class="filter-label">审核状态：</text>
        <view class="dropdown-container">
          <view class="dropdown-trigger" bindtap="toggleStatusDropdown">
            <text class="dropdown-text">{{selectedStatusText}}</text>
            <text class="dropdown-arrow {{statusDropdownOpen ? 'open' : ''}}">▼</text>
          </view>
          <view class="dropdown-options {{statusDropdownOpen ? 'show' : ''}}" catchtap="stopPropagation">
            <view class="dropdown-option {{selectedStatus === '' ? 'active' : ''}}"
                  bindtap="onStatusSelect" data-value="" data-text="全部状态">
              全部状态
            </view>
            <view class="dropdown-option {{selectedStatus === 'pending' ? 'active' : ''}}"
                  bindtap="onStatusSelect" data-value="pending" data-text="审核中">
              审核中
            </view>
            <view class="dropdown-option {{selectedStatus === 'approved' ? 'active' : ''}}"
                  bindtap="onStatusSelect" data-value="approved" data-text="已通过">
              已通过
            </view>
            <view class="dropdown-option {{selectedStatus === 'rejected' ? 'active' : ''}}"
                  bindtap="onStatusSelect" data-value="rejected" data-text="已拒绝">
              已拒绝
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-container" wx:if="{{loading && comments.length === 0}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 评论列表 -->
  <view class="comments-list" wx:if="{{!loading && comments.length > 0}}">
    <view class="comment-item" wx:for="{{comments}}" wx:key="id">
      <view class="comment-header">
        <view class="comment-target">
          <view class="type-tag {{item.type === 'plant' ? 'tag-plant' : item.type === 'pest_disease' ? 'tag-pest' : 'tag-pesticide'}}">
            {{item.typeText}}
          </view>
          <text class="target-name">{{item.targetName}}</text>
        </view>
        <view class="comment-status">
          <view class="status-tag {{item.status === 'pending' ? 'status-pending' : item.status === 'approved' ? 'status-approved' : 'status-rejected'}}">
            {{item.statusText}}
          </view>
          <text class="comment-time">{{item.createdAt}}</text>
        </view>
      </view>

      <view class="comment-content">
        <text class="content-text">{{item.content}}</text>
      </view>

      <view class="comment-meta" wx:if="{{item.status === 'rejected'}}">
        <view class="meta-item reject-reason">
          <text class="warning-icon">⚠️</text>
          <text class="reason-text">审核未通过，请检查评论内容是否符合规范</text>
        </view>
      </view>

      <view class="comment-footer">
        <view class="footer-left">
          <text class="target-info">评论对象：{{item.targetName}}</text>
        </view>
        <view class="footer-actions">
          <view class="action-btn view-btn" bindtap="viewTarget" data-item="{{item}}">
            <text class="btn-icon">👁</text>
            <text class="btn-text">查看原文</text>
          </view>
          <view class="action-btn edit-btn" wx:if="{{item.status === 'pending'}}"
                bindtap="editComment" data-item="{{item}}">
            <text class="btn-icon">✏️</text>
            <text class="btn-text">编辑</text>
          </view>
          <view class="action-btn delete-btn" bindtap="deleteComment" data-item="{{item}}">
            <text class="btn-icon">🗑️</text>
            <text class="btn-text">删除</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-container" wx:if="{{!loading && comments.length === 0}}">
    <view class="empty-icon">💬</view>
    <text class="empty-title">暂无评论</text>
    <text class="empty-subtitle" wx:if="{{!selectedType && !selectedStatus}}">
      您还没有发表过评论，快去浏览植物、病虫害或农药信息并发表您的看法吧！
    </text>
    <text class="empty-subtitle" wx:else>
      没有找到符合筛选条件的评论
    </text>
    <view class="empty-actions" wx:if="{{!selectedType && !selectedStatus}}">
      <view class="action-btn primary-btn" bindtap="goToPlants">
        <text class="btn-icon">➕</text>
        <text class="btn-text">去发表评论</text>
      </view>
    </view>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{hasMore && !loading}}">
    <view class="load-more-btn" bindtap="loadMore">
      <text class="load-more-text">加载更多</text>
    </view>
  </view>

  <!-- 底部加载状态 -->
  <view class="bottom-loading" wx:if="{{loading && comments.length > 0}}">
    <view class="loading-spinner small"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 没有更多数据 -->
  <view class="no-more" wx:if="{{!hasMore && comments.length > 0}}">
    <text class="no-more-text">没有更多数据了</text>
  </view>
</view>

<!-- 编辑评论弹窗 -->
<view class="modal-overlay {{editModalVisible ? 'show' : ''}}" bindtap="closeEditModal">
  <view class="edit-modal {{editModalVisible ? 'show' : ''}}" catchtap="stopPropagation">
    <view class="modal-header">
      <text class="modal-title">编辑评论</text>
      <view class="close-btn" bindtap="closeEditModal">✕</view>
    </view>

    <view class="modal-content">
      <view class="modal-tip">
        <text class="tip-icon">ℹ️</text>
        <text class="tip-text">只有待审核的评论才能编辑，编辑后需要重新审核</text>
      </view>

      <textarea class="edit-textarea"
                placeholder="请输入评论内容..."
                value="{{editContent}}"
                bindinput="onEditInput"
                maxlength="500"></textarea>

      <view class="char-count">
        <text class="count-text">{{editContent.length}}/500</text>
      </view>
    </view>

    <view class="modal-footer">
      <view class="footer-btn cancel-btn" bindtap="closeEditModal">
        <text class="btn-text">取消</text>
      </view>
      <view class="footer-btn confirm-btn {{!editContent.trim() ? 'disabled' : ''}}"
            bindtap="updateComment">
        <text class="btn-text">保存修改</text>
      </view>
    </view>
  </view>
</view>
