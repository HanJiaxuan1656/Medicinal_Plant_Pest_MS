<!-- 病虫害详情页面 -->
<view class="container" wx:if="{{pestInfo}}">
  <!-- 病虫害图片 -->
  <view class="image-section">
    <image class="pest-image"
           src="{{pestInfo.imageUrl}}"
           mode="aspectFill"
           bindtap="previewImage"></image>
    <view class="image-overlay">
      <text class="pest-name">{{pestInfo.name}}</text>
      <text class="pest-alias" wx:if="{{pestInfo.alias}}">{{pestInfo.alias}}</text>
    </view>
  </view>

  <!-- 基本信息 -->
  <view class="info-section">
    <view class="info-card">
      <view class="card-header">
        <text class="card-title">基本信息</text>
        <view class="view-count">
          <text class="count-icon">👁</text>
          <text class="count-text">{{pestInfo.viewCount || 0}}</text>
        </view>
      </view>

      <view class="info-item" wx:if="{{pestInfo.type}}">
        <text class="info-label">病虫害类型</text>
        <view class="type-container">
          <text class="type-tag {{pestInfo.type === '病害' ? 'tag-disease' : 'tag-pest'}}">
            {{pestInfo.type}}
          </text>
        </view>
      </view>

      <view class="info-item" wx:if="{{pestInfo.severityLevel}}">
        <text class="info-label">危害程度</text>
        <view class="severity-container">
          <text class="severity-tag severity-{{pestInfo.severityLevel}}">
            {{pestInfo.severityText || pestInfo.severityLevel}}
          </text>
        </view>
      </view>

      <view class="info-item" wx:if="{{pestInfo.symptoms}}">
        <text class="info-label">主要症状</text>
        <text class="info-content">{{pestInfo.symptoms}}</text>
      </view>

      <view class="info-item" wx:if="{{pestInfo.description}}">
        <text class="info-label">详细描述</text>
        <text class="info-content description">{{pestInfo.description}}</text>
      </view>

      <view class="info-item" wx:if="{{pestInfo.creator}}">
        <text class="info-label">专家信息</text>
        <view class="expert-info">
          <image class="expert-avatar" src="{{pestInfo.creator.avatarUrl}}" mode="aspectFill"></image>
          <view class="expert-details">
            <text class="expert-name">{{pestInfo.creator.name}}</text>
            <text class="expert-title">{{pestInfo.creator.title}} · {{pestInfo.creator.organization}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 相关农药 -->
  <view class="related-section" wx:if="{{relatedPesticides.length > 0}}">
    <view class="section-header">
      <text class="section-title">相关农药</text>
      <text class="section-count">({{relatedPesticides.length}})</text>
    </view>

    <view class="pesticide-list">
      <view class="pesticide-item"
            wx:for="{{relatedPesticides}}"
            wx:key="id"
            bindtap="goToPesticideDetail"
            data-id="{{item.id}}">
        <view class="pesticide-image-container">
          <image wx:if="{{item.imageUrl}}"
                 class="pesticide-image"
                 src="{{item.imageUrl}}"
                 mode="aspectFill"
                 binderror="onPesticideImageError"
                 data-index="{{index}}"></image>
          <view wx:else class="pesticide-image pesticide-image-placeholder">
            <text class="placeholder-icon">🧪</text>
          </view>
        </view>
        <view class="pesticide-content">
          <view class="pesticide-header">
            <text class="pesticide-name">{{item.name}}</text>
            <view class="pesticide-meta">
              <text class="pesticide-category tag {{item.category === '杀虫剂' ? 'tag-warning' : item.category === '杀菌剂' ? 'tag-danger' : 'tag-info'}}">
                {{item.category}}
              </text>
              <text class="effectiveness tag tag-success" wx:if="{{item.effectiveness}}">
                效果：{{item.effectiveness}}
              </text>
            </view>
          </view>

          <view class="pesticide-description" wx:if="{{item.description}}">
            <text class="desc-label">使用说明：</text>
            <text class="desc-content">{{item.description}}</text>
          </view>

          <view class="pesticide-usage" wx:if="{{item.dosage}}">
            <text class="usage-label">用法用量：</text>
            <text class="usage-content">{{item.dosage}}</text>
          </view>

          <view class="pesticide-method" wx:if="{{item.applicationMethod}}">
            <text class="method-label">施用方法：</text>
            <text class="method-content">{{item.applicationMethod}}</text>
          </view>

          <view class="pesticide-footer">
            <text class="active-ingredient" wx:if="{{item.activeIngredient}}">有效成分：{{item.activeIngredient}}</text>
            <text class="notes" wx:if="{{item.notes}}">备注：{{item.notes}}</text>
          </view>
        </view>
        <view class="arrow-icon">
          <text class="arrow">→</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 评论区域 -->
  <view class="comment-section">
    <view class="section-header">
      <text class="section-title">用户评论</text>
      <text class="section-count">({{comments.length}})</text>
    </view>

    <!-- 发表评论 -->
    <view class="comment-form" wx:if="{{userInfo}}">
      <view class="form-header">
        <image class="user-avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
        <text class="user-name">{{userInfo.nickname || userInfo.username}}</text>
      </view>
      <textarea class="comment-input"
                placeholder="分享你对这个病虫害的了解..."
                value="{{commentContent}}"
                bindinput="onCommentInput"
                maxlength="500"></textarea>
      <view class="form-footer">
        <text class="char-count">{{commentContent.length}}/500</text>
        <button class="submit-btn"
                bindtap="submitComment"
                disabled="{{!isCommentValid}}">
          发表评论
        </button>
      </view>
    </view>

    <!-- 登录提示 -->
    <view class="login-tip" wx:else>
      <text class="tip-text">登录后可发表评论</text>
      <button class="login-btn" bindtap="goToLogin">立即登录</button>
    </view>

    <!-- 评论列表 -->
    <view class="comment-list" wx:if="{{comments.length > 0}}">
      <view class="comment-item" wx:for="{{comments}}" wx:key="id">
        <view class="comment-header">
          <image class="commenter-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
          <view class="commenter-info">
            <text class="commenter-name">{{item.nickname || item.username}}</text>
            <text class="comment-time">{{item.createdAt}}</text>
          </view>
          <view class="user-type" wx:if="{{item.userType === 'expert'}}">
            <text class="expert-badge">专家</text>
          </view>
        </view>
        <text class="comment-content">{{item.content}}</text>
      </view>
    </view>

    <!-- 评论空状态 -->
    <view class="empty-comments" wx:else>
      <text class="empty-icon">💬</text>
      <text class="empty-text">暂无评论，快来发表第一条评论吧！</text>
    </view>
  </view>
</view>

<!-- 加载状态 -->
<view class="loading-container" wx:if="{{loading}}">
  <text class="loading-text">加载中...</text>
</view>

<!-- 底部操作栏 -->
<view class="bottom-actions">
  <button class="action-btn secondary" bindtap="addToFavorites">
    <text class="btn-icon">⭐</text>
    <text class="btn-text">收藏</text>
  </button>
  <button class="action-btn primary" bindtap="shareToFriend">
    <text class="btn-icon">📤</text>
    <text class="btn-text">分享</text>
  </button>
</view>
