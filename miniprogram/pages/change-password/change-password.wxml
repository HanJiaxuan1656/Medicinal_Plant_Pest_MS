<!-- 修改密码页面 -->
<view class="container">
  <!-- 页面头部 -->
  <view class="header-section">
    <view class="header-content">
      <text class="page-title">修改密码</text>
      <text class="page-subtitle">为了您的账户安全，请定期更换密码</text>
    </view>
  </view>

  <!-- 密码表单 -->
  <view class="form-section">
    <view class="form-group">
      <text class="form-label">当前密码</text>
      <view class="form-input-wrapper">
        <input 
          class="form-input" 
          value="{{passwordForm.currentPassword}}" 
          bindinput="onCurrentPasswordInput"
          placeholder="请输入当前密码"
          password="{{!showCurrentPassword}}"
          type="text"
        />
        <text 
          class="toggle-password" 
          bindtap="toggleCurrentPassword"
        >
          {{showCurrentPassword ? '🙈' : '👁️'}}
        </text>
      </view>
    </view>

    <view class="form-group">
      <text class="form-label">新密码</text>
      <view class="form-input-wrapper">
        <input 
          class="form-input" 
          value="{{passwordForm.newPassword}}" 
          bindinput="onNewPasswordInput"
          placeholder="请输入新密码（至少6位）"
          password="{{!showNewPassword}}"
          type="text"
        />
        <text 
          class="toggle-password" 
          bindtap="toggleNewPassword"
        >
          {{showNewPassword ? '🙈' : '👁️'}}
        </text>
      </view>
      <text class="form-tip" wx:if="{{newPasswordError}}">{{newPasswordError}}</text>
    </view>

    <view class="form-group">
      <text class="form-label">确认新密码</text>
      <view class="form-input-wrapper">
        <input 
          class="form-input" 
          value="{{passwordForm.confirmPassword}}" 
          bindinput="onConfirmPasswordInput"
          placeholder="请再次输入新密码"
          password="{{!showConfirmPassword}}"
          type="text"
        />
        <text 
          class="toggle-password" 
          bindtap="toggleConfirmPassword"
        >
          {{showConfirmPassword ? '🙈' : '👁️'}}
        </text>
      </view>
      <text class="form-tip" wx:if="{{confirmPasswordError}}">{{confirmPasswordError}}</text>
    </view>
  </view>

  <!-- 密码强度提示 -->
  <view class="password-strength" wx:if="{{passwordForm.newPassword}}">
    <view class="strength-title">密码强度</view>
    <view class="strength-bar">
      <view class="strength-fill {{strengthLevel}}"></view>
    </view>
    <view class="strength-text">{{strengthText}}</view>
    
    <view class="strength-tips">
      <text class="tip-title">密码建议：</text>
      <view class="tip-item {{hasLength ? 'valid' : ''}}">
        <text class="tip-icon">{{hasLength ? '✅' : '❌'}}</text>
        <text class="tip-text">至少6个字符</text>
      </view>
      <view class="tip-item {{hasNumber ? 'valid' : ''}}">
        <text class="tip-icon">{{hasNumber ? '✅' : '❌'}}</text>
        <text class="tip-text">包含数字</text>
      </view>
      <view class="tip-item {{hasLetter ? 'valid' : ''}}">
        <text class="tip-icon">{{hasLetter ? '✅' : '❌'}}</text>
        <text class="tip-text">包含字母</text>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-section">
    <button 
      class="change-btn {{isFormValid ? 'active' : 'disabled'}}" 
      bindtap="changePassword"
      disabled="{{!isFormValid || changing}}"
    >
      <text class="btn-icon" wx:if="{{changing}}">⏳</text>
      <text class="btn-icon" wx:else>🔐</text>
      <text class="btn-text">{{changing ? '修改中...' : '修改密码'}}</text>
    </button>
  </view>

  <!-- 安全提示 -->
  <view class="security-tips">
    <view class="tips-title">🛡️ 安全提示</view>
    <view class="tips-content">
      <view class="tip-item">
        <text class="tip-dot">•</text>
        <text class="tip-text">密码修改成功后需要重新登录</text>
      </view>
      <view class="tip-item">
        <text class="tip-dot">•</text>
        <text class="tip-text">建议使用字母、数字组合的强密码</text>
      </view>
      <view class="tip-item">
        <text class="tip-dot">•</text>
        <text class="tip-text">请勿在公共场所输入密码</text>
      </view>
      <view class="tip-item">
        <text class="tip-dot">•</text>
        <text class="tip-text">定期更换密码以保障账户安全</text>
      </view>
    </view>
  </view>
</view>

<!-- 加载状态 -->
<view class="loading-overlay" wx:if="{{loading}}">
  <view class="loading-content">
    <text class="loading-icon">⏳</text>
    <text class="loading-text">处理中...</text>
  </view>
</view>
