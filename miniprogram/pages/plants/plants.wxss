/* 植物列表页面样式 */
.container {
  padding: 0;
  background: #f5f5f5;
  min-height: 100vh;
}

/* 搜索筛选区域 */
.search-filter-section {
  background: #fff;
  padding: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  position: sticky;
  top: 0;
  z-index: 100;
}

.search-box {
  display: flex;
  align-items: center;
  background: #f8f9fa;
  border-radius: 50rpx;
  padding: 20rpx 30rpx;
  margin-bottom: 30rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.search-btn {
  font-size: 32rpx;
  color: #4CAF50;
  margin-left: 20rpx;
}

/* 筛选区域 */
.filter-section {
  margin-bottom: 20rpx;
}

.filter-item-wrapper {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.filter-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  white-space: nowrap;
}

/* 下拉框容器 */
.dropdown-container {
  position: relative;
  flex: 1;
  max-width: 300rpx;
}

.dropdown-trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  background: #f8f9fa;
  border: 2rpx solid #e9ecef;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
  transition: all 0.3s;
}

.dropdown-trigger:active {
  background: #e9ecef;
}

.dropdown-text {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dropdown-arrow {
  font-size: 24rpx;
  color: #666;
  transition: transform 0.3s;
  margin-left: 10rpx;
}

.dropdown-arrow.open {
  transform: rotate(180deg);
}

/* 下拉选项 */
.dropdown-options {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  background: #fff;
  border: 2rpx solid #e9ecef;
  border-top: none;
  border-radius: 0 0 8rpx 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  z-index: 1000;
  max-height: 400rpx;
  overflow-y: auto;
  opacity: 0;
  transform: translateY(-10rpx);
  transition: all 0.3s;
  pointer-events: none;
}

.dropdown-options.show {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.dropdown-option {
  padding: 20rpx;
  font-size: 28rpx;
  color: #333;
  border-bottom: 1rpx solid #f0f0f0;
  transition: background-color 0.2s;
}

.dropdown-option:last-child {
  border-bottom: none;
}

.dropdown-option:hover {
  background: #f8f9fa;
}

.dropdown-option.active {
  background: #e8f5e8;
  color: #4CAF50;
  font-weight: 500;
}

/* 排序区域 */
.sort-section {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.sort-label {
  font-size: 26rpx;
  color: #666;
}

.sort-options {
  display: flex;
  gap: 30rpx;
}

.sort-item {
  font-size: 26rpx;
  color: #666;
  position: relative;
}

.sort-item.active {
  color: #4CAF50;
  font-weight: 500;
}

.sort-item.active::after {
  content: '';
  position: absolute;
  bottom: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 20rpx;
  height: 4rpx;
  background: #4CAF50;
  border-radius: 2rpx;
}

/* 植物列表 */
.plants-list {
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.plant-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.3s;
}

.plant-card:active {
  transform: scale(0.98);
}

.plant-image {
  width: 100%;
  height: 400rpx;
}

.plant-content {
  padding: 30rpx;
}

.plant-header {
  margin-bottom: 20rpx;
}

.plant-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.plant-alias {
  font-size: 26rpx;
  color: #666;
  background: #f0f0f0;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  display: inline-block;
}

/* 药用部位 */
.plant-parts {
  margin-bottom: 20rpx;
}

.parts-label {
  font-size: 24rpx;
  color: #666;
  margin-right: 12rpx;
}

.parts-tags {
  display: inline-flex;
  gap: 8rpx;
  flex-wrap: wrap;
}

.part-tag {
  font-size: 22rpx;
  color: #4CAF50;
  background: #e8f5e8;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
}

/* 植物描述 */
.plant-description {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 植物底部信息 */
.plant-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.plant-stats {
  display: flex;
  gap: 20rpx;
}

.stat-item {
  font-size: 24rpx;
  color: #999;
}

.view-detail {
  font-size: 26rpx;
  color: #4CAF50;
  font-weight: 500;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  display: block;
  margin-bottom: 40rpx;
}

.retry-btn {
  background: #4CAF50;
  color: #fff;
  border: none;
  border-radius: 50rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
}

/* 加载更多 */
.load-more {
  padding: 40rpx;
  text-align: center;
}

.load-more-btn {
  background: #f0f0f0;
  color: #666;
  border: none;
  border-radius: 50rpx;
  padding: 20rpx 60rpx;
  font-size: 26rpx;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 60rpx;
  color: #999;
  font-size: 26rpx;
}

/* 返回顶部 */
.back-to-top {
  position: fixed;
  bottom: 200rpx;
  right: 30rpx;
  width: 80rpx;
  height: 80rpx;
  background: rgba(76, 175, 80, 0.8);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transform: translateY(20rpx);
  transition: all 0.3s;
  z-index: 100;
}

.back-to-top.show {
  opacity: 1;
  transform: translateY(0);
}

.back-icon {
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
}
