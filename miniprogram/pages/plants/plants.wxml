<!-- 植物列表页面 -->
<view class="container" bindtap="closeDropdown">
  <!-- 搜索和筛选 -->
  <view class="search-filter-section">
    <view class="search-box">
      <input class="search-input"
             placeholder="搜索植物名称或别名..."
             value="{{searchKeyword}}"
             bindinput="onSearchInput"
             bindconfirm="onSearch" />
      <text class="search-btn" bindtap="onSearch">🔍</text>
    </view>
    
    <!-- 筛选选项 -->
    <view class="filter-section">
      <view class="filter-item-wrapper">
        <text class="filter-label">药用部位：</text>
        <view class="dropdown-container" catchtap="stopPropagation">
          <view class="dropdown-trigger" bindtap="toggleDropdown">
            <text class="dropdown-text">{{selectedPartText}}</text>
            <text class="dropdown-arrow {{dropdownOpen ? 'open' : ''}}">▼</text>
          </view>

          <!-- 下拉选项 -->
          <view class="dropdown-options {{dropdownOpen ? 'show' : ''}}" catchtap="stopPropagation">
            <view class="dropdown-option {{selectedPart === '' ? 'active' : ''}}"
                  bindtap="onPartSelect"
                  data-value=""
                  data-text="全部">
              全部
            </view>
            <view class="dropdown-option {{selectedPart === item ? 'active' : ''}}"
                  wx:for="{{medicinalParts}}"
                  wx:key="*this"
                  bindtap="onPartSelect"
                  data-value="{{item}}"
                  data-text="{{item}}">
              {{item}}
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 排序选项 -->
    <view class="sort-section">
      <text class="sort-label">排序：</text>
      <view class="sort-options">
        <text class="sort-item {{sortBy === 'default' ? 'active' : ''}}" 
              bindtap="onSortChange" 
              data-value="default">
          默认
        </text>
        <text class="sort-item {{sortBy === 'viewCount' ? 'active' : ''}}" 
              bindtap="onSortChange" 
              data-value="viewCount">
          热度
        </text>
        <text class="sort-item {{sortBy === 'latest' ? 'active' : ''}}" 
              bindtap="onSortChange" 
              data-value="latest">
          最新
        </text>
      </view>
    </view>
  </view>

  <!-- 植物列表 -->
  <view class="plants-list" wx:if="{{!loading && plants.length > 0}}">
    <view class="plant-card" 
          wx:for="{{plants}}" 
          wx:key="id" 
          bindtap="goToDetail" 
          data-id="{{item.id}}">
      <image class="plant-image"
             src="{{item.imageUrl}}"
             mode="aspectFill"
             lazy-load
             binderror="onImageError"
             data-index="{{index}}"></image>
      
      <view class="plant-content">
        <view class="plant-header">
          <text class="plant-name">{{item.name}}</text>
          <text class="plant-alias" wx:if="{{item.alias}}">{{item.alias}}</text>
        </view>
        
        <view class="plant-parts" wx:if="{{item.medicinalParts}}">
          <text class="parts-label">药用部位：</text>
          <view class="parts-tags">
            <text class="part-tag" wx:for="{{item.medicinalPartsArray}}" wx:key="*this">
              {{item}}
            </text>
          </view>
        </view>
        
        <text class="plant-description">{{item.description}}</text>
        
        <view class="plant-footer">
          <view class="plant-stats">
            <text class="stat-item">👁 {{item.viewCount || 0}}</text>
            <text class="stat-item">📅 {{item.createdAt}}</text>
          </view>
          <text class="view-detail">查看详情 ></text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && plants.length === 0}}">
    <text class="empty-icon">🌱</text>
    <text class="empty-text">暂无植物数据</text>
    <button class="retry-btn" bindtap="loadPlants">重新加载</button>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{hasMore && !loading}}">
    <button class="load-more-btn" bindtap="loadMore">加载更多</button>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>

<!-- 返回顶部 -->
<view class="back-to-top {{showBackTop ? 'show' : ''}}" bindtap="backToTop">
  <text class="back-icon">↑</text>
</view>
