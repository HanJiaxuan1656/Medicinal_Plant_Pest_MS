/* 求助详情页面样式 */
.container {
  min-height: 100vh;
  background: #f8f9fa;
  padding-bottom: 40rpx;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #f3f3f3;
  border-top: 6rpx solid #4CAF50;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #666;
}

/* 求助详情 */
.help-detail {
  padding: 0 30rpx;
}

/* 求助头部 */
.help-header {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  margin: 30rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.help-title-section {
  flex: 1;
  margin-right: 20rpx;
}

.help-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
  margin-bottom: 20rpx;
}

.help-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-wrap: wrap;
}

.status-tag {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.status-approved {
  background: #e8f5e8;
  color: #4CAF50;
}

.status-pending {
  background: #fff3cd;
  color: #856404;
}

.status-rejected {
  background: #f8d7da;
  color: #721c24;
}

.time-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.time-icon {
  font-size: 24rpx;
}

.time-text {
  font-size: 24rpx;
  color: #666;
}

.help-stats {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-number {
  font-size: 32rpx;
  font-weight: bold;
  color: #4CAF50;
}

.stat-label {
  font-size: 24rpx;
  color: #666;
}

/* 求助内容 */
.help-content {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.content-section {
  margin-bottom: 30rpx;
}

.content-section:last-child {
  margin-bottom: 0;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.title-icon {
  font-size: 32rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.help-description {
  font-size: 30rpx;
  line-height: 1.6;
  color: #333;
  white-space: pre-wrap;
}

/* 图片展示 */
.help-images {
  margin-top: 30rpx;
}

.image-gallery {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 20rpx;
}

.help-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

/* 回复区域 */
.replies-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.refresh-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: #f0f0f0;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #666;
}

.refresh-icon {
  font-size: 24rpx;
}

.refresh-text {
  font-size: 24rpx;
}

/* 回复列表 */
.replies-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.reply-item {
  padding: 30rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  border-left: 6rpx solid #4CAF50;
}

.reply-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.expert-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.expert-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  overflow: hidden;
  position: relative;
}

.avatar-image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text {
  font-size: 24rpx;
  font-weight: bold;
  color: #fff;
}

.expert-details {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.expert-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.expert-title {
  font-size: 24rpx;
  color: #666;
}

.reply-time .time-text {
  font-size: 24rpx;
  color: #999;
}

.reply-content {
  margin-bottom: 20rpx;
}

.reply-text {
  font-size: 30rpx;
  line-height: 1.6;
  color: #333;
  white-space: pre-wrap;
}

.reply-images {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.reply-image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.reply-footer {
  display: flex;
  justify-content: flex-end;
}

.thank-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  transition: all 0.3s;
}

.thank-btn:not(.thanked) {
  background: #fff3cd;
  color: #856404;
}

.thank-btn.thanked {
  background: #e8f5e8;
  color: #4CAF50;
}

.thank-icon {
  font-size: 24rpx;
}

.thank-text {
  font-size: 24rpx;
}

/* 无回复状态 */
.no-replies {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  text-align: center;
}

.no-replies-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  opacity: 0.6;
}

.no-replies-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.no-replies-tip {
  font-size: 26rpx;
  color: #999;
}

/* 操作按钮区域 */
.action-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.resolve-btn {
  background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(76, 175, 80, 0.3);
}

.resolve-btn:not([disabled]):active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.3);
}

.resolve-btn[disabled] {
  background: #ccc;
  box-shadow: none;
  color: #999;
}

.delete-btn {
  background: linear-gradient(135deg, #ff4757 0%, #ff3742 100%);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(255, 71, 87, 0.3);
}

.delete-btn:not([disabled]):active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(255, 71, 87, 0.3);
}

.delete-btn[disabled] {
  background: #ccc;
  box-shadow: none;
  color: #999;
}

/* 底部安全区域 */
.safe-area-bottom {
  height: 40rpx;
}

/* 响应式设计 */
@media screen and (max-width: 750rpx) {
  .help-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 20rpx;
  }

  .help-title-section {
    margin-right: 0;
  }

  .help-stats {
    align-self: flex-end;
  }

  .image-gallery {
    justify-content: center;
  }

  .help-image {
    width: 160rpx;
    height: 160rpx;
  }

  .reply-image {
    width: 120rpx;
    height: 120rpx;
  }
}

/* 深色模式适配 */
@media (prefers-color-scheme: dark) {
  .container {
    background: #1a1a1a;
  }

  .help-header,
  .help-content,
  .replies-section,
  .action-section {
    background: #2d2d2d;
    color: #fff;
  }

  .help-title,
  .title-text,
  .expert-name,
  .reply-text,
  .help-description {
    color: #fff;
  }

  .time-text,
  .expert-title,
  .stat-label {
    color: #ccc;
  }

  .reply-item {
    background: #3a3a3a;
  }
}