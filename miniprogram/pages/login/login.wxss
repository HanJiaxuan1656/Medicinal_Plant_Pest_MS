/* 登录页面样式 */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);
  position: relative;
  overflow: hidden;
}

/* 顶部装饰 */
.header-decoration {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 300rpx;
  overflow: hidden;
}

.decoration-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.circle-1 {
  width: 200rpx;
  height: 200rpx;
  top: -100rpx;
  right: 50rpx;
}

.circle-2 {
  width: 150rpx;
  height: 150rpx;
  top: 50rpx;
  left: -75rpx;
}

.circle-3 {
  width: 100rpx;
  height: 100rpx;
  top: 150rpx;
  right: 150rpx;
}

/* 登录表单 */
.login-form {
  padding: 200rpx 40rpx 40rpx;
  position: relative;
  z-index: 10;
}

/* Logo区域 */
.logo-section {
  text-align: center;
  margin-bottom: 80rpx;
}

.logo-icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 20rpx;
}

.app-title {
  font-size: 48rpx;
  font-weight: 600;
  color: #fff;
  display: block;
  margin-bottom: 12rpx;
}

.app-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 登录方式 */
.login-methods {
  background: #fff;
  border-radius: 30rpx;
  padding: 50rpx 40rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.15);
}



/* 表单登录 */
.form-login {
  margin-top: 20rpx;
}

.input-group {
  margin-bottom: 40rpx;
}

.input-item {
  position: relative;
  margin-bottom: 30rpx;
  background: #f8f9fa;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
}

.input-icon {
  font-size: 32rpx;
  color: #666;
  margin-right: 20rpx;
}

.input-field {
  flex: 1;
  padding: 32rpx 0;
  font-size: 28rpx;
  color: #333;
}

.password-toggle {
  padding: 16rpx;
  margin-right: -16rpx;
}

.toggle-icon {
  font-size: 32rpx;
  color: #666;
}

/* 表单登录按钮 */
.form-login-btn {
  width: 100%;
  background: #4CAF50;
  color: #fff;
  border: none;
  border-radius: 50rpx;
  padding: 32rpx;
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 30rpx;
}

.form-login-btn[disabled] {
  background: #ccc;
  color: #999;
}

/* 注册链接 */
.register-link {
  text-align: center;
  font-size: 26rpx;
}

.link-text {
  color: #666;
}

.link-btn {
  color: #4CAF50;
  font-weight: 500;
  margin-left: 8rpx;
}

/* 游客模式 */
.guest-mode {
  text-align: center;
  margin-top: 40rpx;
  font-size: 26rpx;
}

.guest-text {
  color: rgba(255, 255, 255, 0.8);
}

.guest-btn {
  color: #fff;
  font-weight: 500;
  text-decoration: underline;
}

/* 底部信息 */
.footer-info {
  position: absolute;
  bottom: 40rpx;
  left: 40rpx;
  right: 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.5;
}

.privacy-link {
  color: #fff;
  text-decoration: underline;
}

/* 加载遮罩 */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.loading-content {
  background: #fff;
  border-radius: 20rpx;
  padding: 60rpx;
  text-align: center;
  min-width: 300rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f0f0f0;
  border-top: 4rpx solid #4CAF50;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin: 0 auto 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #333;
}