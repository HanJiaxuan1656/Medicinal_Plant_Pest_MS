<!-- 编辑个人信息页面 -->
<view class="container">
  <!-- 页面头部 -->
  <view class="header-section">
    <view class="header-content">
      <text class="page-title">编辑个人信息</text>
      <text class="page-subtitle">完善您的个人资料</text>
    </view>
  </view>

  <!-- 头像编辑区域 -->
  <view class="avatar-section">
    <view class="avatar-container">
      <view class="avatar-wrapper" bindtap="chooseAvatar">
        <image 
          class="avatar-image" 
          src="{{userInfo.avatarUrl || '/images/default-avatar.png'}}" 
          mode="aspectFill"
        ></image>
        <view class="avatar-overlay">
          <text class="camera-icon">📷</text>
          <text class="upload-text">更换头像</text>
        </view>
      </view>
      <text class="avatar-tip">点击更换头像</text>
    </view>
  </view>

  <!-- 个人信息表单 -->
  <view class="form-section">
    <view class="form-group">
      <text class="form-label">用户名</text>
      <view class="form-input-wrapper">
        <input 
          class="form-input disabled" 
          value="{{userInfo.username}}" 
          disabled
          placeholder="用户名"
        />
        <text class="input-icon">👤</text>
      </view>
      <text class="form-tip">用户名不可修改</text>
    </view>

    <view class="form-group">
      <text class="form-label">昵称</text>
      <view class="form-input-wrapper">
        <input 
          class="form-input" 
          value="{{formData.nickname}}" 
          bindinput="onNicknameInput"
          placeholder="请输入昵称"
          maxlength="20"
        />
        <text class="input-icon">✨</text>
      </view>
      <text class="char-count">{{formData.nickname.length}}/20</text>
    </view>

    <view class="form-group">
      <text class="form-label">手机号码</text>
      <view class="form-input-wrapper">
        <input 
          class="form-input" 
          value="{{formData.phone}}" 
          bindinput="onPhoneInput"
          placeholder="请输入手机号码"
          type="number"
          maxlength="11"
        />
        <text class="input-icon">📱</text>
      </view>
      <text class="form-tip" wx:if="{{phoneError}}">{{phoneError}}</text>
    </view>

    <view class="form-group">
      <text class="form-label">邮箱地址</text>
      <view class="form-input-wrapper">
        <input 
          class="form-input" 
          value="{{formData.email}}" 
          bindinput="onEmailInput"
          placeholder="请输入邮箱地址"
          type="text"
        />
        <text class="input-icon">📧</text>
      </view>
      <text class="form-tip" wx:if="{{emailError}}">{{emailError}}</text>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-section">
    <button 
      class="save-btn {{isFormValid ? 'active' : 'disabled'}}" 
      bindtap="saveProfile"
      disabled="{{!isFormValid || saving}}"
    >
      <text class="btn-icon" wx:if="{{saving}}">⏳</text>
      <text class="btn-icon" wx:else>💾</text>
      <text class="btn-text">{{saving ? '保存中...' : '保存信息'}}</text>
    </button>
    
    <button class="reset-btn" bindtap="resetForm">
      <text class="btn-icon">🔄</text>
      <text class="btn-text">重置</text>
    </button>
  </view>

  <!-- 修改密码入口 -->
  <view class="password-section">
    <view class="password-card" bindtap="goToChangePassword">
      <view class="password-content">
        <view class="password-icon">🔐</view>
        <view class="password-info">
          <text class="password-title">修改密码</text>
          <text class="password-desc">更改您的登录密码</text>
        </view>
      </view>
      <text class="arrow-icon">></text>
    </view>
  </view>

  <!-- 统计信息 -->
  <view class="stats-section">
    <view class="stats-title">我的统计</view>
    <view class="stats-grid">
      <view class="stat-item">
        <text class="stat-number">{{userStats.commentCount || 0}}</text>
        <text class="stat-label">评论数</text>
        <text class="stat-icon">💬</text>
      </view>
      <view class="stat-item">
        <text class="stat-number">{{userStats.helpCount || 0}}</text>
        <text class="stat-label">求助数</text>
        <text class="stat-icon">❓</text>
      </view>
    </view>
  </view>
</view>

<!-- 加载状态 -->
<view class="loading-overlay" wx:if="{{loading}}">
  <view class="loading-content">
    <text class="loading-icon">⏳</text>
    <text class="loading-text">加载中...</text>
  </view>
</view>
